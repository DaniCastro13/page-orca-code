---
import "../styles/global.css"
import Navbar from "../components/Navbar.astro"
import Home from "../components/Home.astro";
import AboutMe from "../components/AboutMe.astro";
import Services from "../components/Services.astro";
import DevUtilities from "../components/DevUtilities.astro";
import Proyects from "../components/Proyects.astro";
import Testimonios from "../components/Testimonios.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <link rel="icon" href="/logoOrcaCode.ico"/>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <title>Orca Code</title>
</head>
<body class="overflow-x-hidden bg-white text-gray-800 antialiased flex flex-col min-h-screen">
<!-- Fondo animado sutil con partículas -->
<div class="fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-0 bg-white"></div>

    <!-- Partículas flotantes sutiles -->
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-blue-100 rounded-full opacity-60 animate-float-slow"></div>
    <div class="absolute top-1/3 right-1/4 w-3 h-3 bg-indigo-100 rounded-full opacity-50 animate-float-medium" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-1/4 left-1/3 w-4 h-4 bg-purple-100 rounded-full opacity-40 animate-float-slow" style="animation-delay: 2s;"></div>
    <div class="absolute top-2/3 right-1/3 w-2 h-2 bg-blue-50 rounded-full opacity-60 animate-float-fast" style="animation-delay: 0.5s;"></div>

    <!-- Efectos de gradiente muy sutiles -->
    <div class="absolute top-0 left-0 w-full h-full opacity-3">
        <div class="absolute top-0 left-0 w-96 h-96 bg-blue-50 rounded-full mix-blend-multiply filter blur-3xl animate-pulse-slow"></div>
        <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-50 rounded-full mix-blend-multiply filter blur-3xl animate-pulse-medium" style="animation-delay: 2s;"></div>
        <div class="absolute bottom-0 left-1/2 w-96 h-96 bg-purple-50 rounded-full mix-blend-multiply filter blur-3xl animate-pulse-slow" style="animation-delay: 4s;"></div>
    </div>
</div>

<!-- Navbar -->
<div class="relative z-50 flex-shrink-0">
    <Navbar/>
</div>

<!-- Contenido principal con animaciones escalonadas -->
<main class="relative z-10 flex-grow">
    <!-- Home Section -->
    <section data-scroll-section class="bg-white">
        <Home title="Transformamos desafíos en ventajas competitivas."/>
    </section>

    <!-- About Me Section -->
    <section data-scroll-section class="bg-white">
        <AboutMe title="Sobre Mi"/>
    </section>

    <!-- Services Section -->
    <section data-scroll-section class="bg-white">
        <Services title="Servicios"/>
    </section>

    <!-- Dev Utilities Section -->
    <section data-scroll-section class="bg-white">
        <DevUtilities/>
    </section>

    <!-- Projects Section -->
    <section data-scroll-section class="bg-white">
        <Proyects/>
    </section>

    <!-- Testimonials Section -->
    <section data-scroll-section class="bg-white">
        <Testimonios/>
    </section>
</main>

<!-- Footer - se pega al fondo -->
<div class="flex-shrink-0">
    <Footer/>
</div>

<!-- Botón de scroll to top -->
<button id="scrollToTop" class="fixed bottom-8 right-8 z-40 w-12 h-12 bg-blue-600 hover:bg-blue-700 text-white rounded-full flex items-center justify-center shadow-lg transition-all duration-300 opacity-0 scale-0 hover:scale-110 group border border-blue-700">
    <i class="fas fa-chevron-up text-sm group-hover:-translate-y-1 transition-transform"></i>
</button>

<!-- Loading inicial -->
<div id="loading" class="fixed inset-0 z-50 flex items-center justify-center bg-white transition-opacity duration-500">
    <div class="text-center">
        <div class="w-16 h-16 border-4 border-blue-100 border-t-blue-600 rounded-full animate-spin mx-auto mb-4"></div>
        <p class="text-gray-600 font-semibold animate-pulse">Cargando Orca Code...</p>
    </div>
</div>

<script>
    // Loading inicial
    window.addEventListener('load', function() {
        setTimeout(() => {
            const loading = document.getElementById('loading');
            loading.classList.add('opacity-0');
            setTimeout(() => loading.remove(), 500);
        }, 1000);
    });

    // Scroll to top button
    const scrollToTop = document.getElementById('scrollToTop');

    function toggleScrollButton() {
        if (window.scrollY > 300) {
            scrollToTop.classList.remove('opacity-0', 'scale-0');
            scrollToTop.classList.add('opacity-100', 'scale-100');
        } else {
            scrollToTop.classList.remove('opacity-100', 'scale-100');
            scrollToTop.classList.add('opacity-0', 'scale-0');
        }
    }

    scrollToTop.addEventListener('click', () => {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });

    window.addEventListener('scroll', toggleScrollButton);

    // Intersection Observer para animaciones al hacer scroll
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('animate-fade-in-up');
            }
        });
    }, observerOptions);

    // Observar todas las secciones
    document.querySelectorAll('section[data-scroll-section]').forEach(section => {
        observer.observe(section);
    });

    // Efecto de parallax suave
    function handleParallax() {
        const scrolled = window.pageYOffset;
        const parallaxElements = document.querySelectorAll('.parallax');

        parallaxElements.forEach(element => {
            const speed = element.dataset.speed || 0.5;
            const yPos = -(scrolled * speed);
            element.style.transform = `translateY(${yPos}px)`;
        });
    }

    window.addEventListener('scroll', handleParallax);
</script>

<style>
    /* Animaciones personalizadas */
    @keyframes float-slow {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(180deg); }
    }

    @keyframes float-medium {
        0%, 100% { transform: translateY(0px) scale(1); }
        50% { transform: translateY(-10px) scale(1.05); }
    }

    @keyframes float-fast {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-8px); }
    }

    @keyframes pulse-slow {
        0%, 100% { opacity: 0.03; transform: scale(1); }
        50% { opacity: 0.06; transform: scale(1.1); }
    }

    @keyframes pulse-medium {
        0%, 100% { opacity: 0.04; transform: scale(1); }
        50% { opacity: 0.08; transform: scale(1.05); }
    }

    @keyframes fade-in-up {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-float-slow {
        animation: float-slow 8s ease-in-out infinite;
    }

    .animate-float-medium {
        animation: float-medium 6s ease-in-out infinite;
    }

    .animate-float-fast {
        animation: float-fast 4s ease-in-out infinite;
    }

    .animate-pulse-slow {
        animation: pulse-slow 6s ease-in-out infinite;
    }

    .animate-pulse-medium {
        animation: pulse-medium 4s ease-in-out infinite;
    }

    .animate-fade-in-up {
        animation: fade-in-up 0.6s ease-out forwards;
    }

    /* Smooth scrolling */
    html {
        scroll-behavior: smooth;
    }

    /* Flexbox para eliminar espacio en blanco */
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }
</style>
</body>
</html>