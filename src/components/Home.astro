---
interface Props {
    title: string,
}
const { title } = Astro.props;
---

<main>
    <div class="relative bg-gradient-to-br from-slate-900 via-blue-900 to-slate-800 w-full h-screen min-h-[900px] bg-cover bg-center overflow-hidden">
        <!-- Fondo con overlay y textura de agua -->
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-400/10 via-transparent to-transparent"></div>

        <!-- Ilustración de la orca -->
        <div class="absolute inset-0 z-0">
            <!-- Orca principal -->
            <div class="absolute bottom-10 right-10 w-96 h-64 opacity-90 transform translate-x-20 translate-y-10">
                <!-- Cuerpo de la orca -->
                <div class="absolute w-full h-32 bg-gradient-to-r from-black to-gray-900 rounded-full"></div>
                <!-- Aleta dorsal -->
                <div class="absolute top-0 right-1/2 w-6 h-20 bg-black transform -translate-y-8 rounded-t-lg"></div>
                <!-- Mancha ocular -->
                <div class="absolute top-8 left-16 w-8 h-4 bg-white rounded-full opacity-80"></div>
                <!-- Mancha blanca -->
                <div class="absolute bottom-4 left-12 w-24 h-8 bg-white/90 rounded-l-full"></div>
                <!-- Cola -->
                <div class="absolute left-0 top-1/2 w-16 h-12 bg-black transform -translate-y-1/2 -rotate-45"></div>
            </div>

            <!-- Burbujas decorativas -->
            <div class="absolute bottom-20 left-20 w-6 h-6 bg-white/30 rounded-full animate-bubble-1"></div>
            <div class="absolute bottom-40 left-40 w-4 h-4 bg-white/40 rounded-full animate-bubble-2"></div>
            <div class="absolute bottom-60 right-60 w-5 h-5 bg-white/35 rounded-full animate-bubble-3"></div>
            <div class="absolute bottom-32 right-32 w-3 h-3 bg-white/50 rounded-full animate-bubble-4"></div>
        </div>

        <!-- Contenido -->
        <div class="relative flex flex-col items-center justify-center h-full px-6 gap-10 text-center z-10">
            <!-- Título con estilo de marca -->
            <div class="animate-fade-in">
                <div class="flex items-center justify-center mb-2">
                    <div class="w-12 h-8 bg-gradient-to-r from-white to-gray-300 rounded-l-full mr-4"></div>
                    <h2 class="text-white text-5xl md:text-7xl lg:text-8xl font-bold leading-tight tracking-tight">
                        {title}
                    </h2>
                    <div class="w-12 h-8 bg-black rounded-r-full ml-4"></div>
                </div>
                <div class="w-24 h-1 bg-gradient-to-r from-blue-400 to-white mx-auto mt-4 rounded-full"></div>
            </div>

            <!-- Párrafo con icono de orca -->
            <div class="max-w-3xl animate-slide-up">
                <div class="flex items-center justify-center mb-6">
                    <div class="w-8 h-8 bg-black rounded-l-full mr-2"></div>
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <div class="text-blue-300 text-lg font-semibold mx-3">ORCA CODE</div>
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <div class="w-8 h-8 bg-white rounded-r-full ml-2"></div>
                </div>
                <p class="text-slate-200 text-xl md:text-2xl leading-relaxed font-light">
                    En <span class="font-semibold text-blue-300">Orca Code</span> navegamos contigo en el océano digital.
                    Como la <span class="text-white font-medium">orca</span>, somos <span class="text-blue-300 font-medium">estrategas inteligentes</span>
                    que no solo identificamos problemas, sino que <span class="text-blue-300 font-medium">creamos soluciones poderosas</span>
                    que se convierten en tu <span class="text-white font-medium">ventaja competitiva</span>.
                </p>
            </div>

            <!-- Botones CTA con estilo de orca -->
            <div class="flex flex-col sm:flex-row gap-6 mt-4 animate-fade-in-delay">
                <button class="group bg-gradient-to-r from-gray-800 to-black hover:from-gray-700 hover:to-gray-900
                          text-white font-semibold py-4 px-10 rounded-xl
                          transition-all duration-300 transform hover:scale-105 hover:shadow-2xl
                          border border-white/20 shadow-lg cursor-pointer relative overflow-hidden">
                    <span class="relative z-10 flex items-center gap-3">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                        </svg>
                        Ver Proyectos
                    </span>
                    <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-blue-400 to-white transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"></div>
                </button>

                <a href="https://wa.me/525536325801?text=Hola,%20me%20interesa%20conversar%20sobre%20un%20proyecto"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="group bg-gradient-to-r from-white to-gray-200 hover:from-blue-50 hover:to-white
                          text-gray-800 hover:text-gray-900 font-semibold py-4 px-10 rounded-xl
                          transition-all duration-300 transform hover:scale-105 hover:shadow-2xl
                          border border-white/30 shadow-lg cursor-pointer flex items-center justify-center gap-3 relative overflow-hidden">
                    <span class="relative z-10 flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                        Enviar mensaje
                    </span>
                    <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-black to-gray-700 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"></div>
                </a>
            </div>

            <!-- Sección de contacto con estilo marino -->
            <div class="flex flex-col justify-center items-center mt-12 animate-slide-up-delay">
                <div class="mb-6">
                    <h3 class="text-white text-2xl md:text-3xl text-center font-light">
                        ¿Tienes una idea? <span class="text-blue-300 font-bold">Naveguemos juntos hacia el éxito</span>
                    </h3>
                </div>
                <div class="flex flex-col sm:flex-row items-center gap-8">
                    <div class="text-slate-300 text-lg flex items-center gap-3 group cursor-pointer">
                        <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center group-hover:bg-blue-600 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </div>
                        <span class="group-hover:text-white transition-colors">55 3632 5801</span>
                    </div>
                    <div class="text-slate-300 text-lg flex items-center gap-3 group cursor-pointer">
                        <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center group-hover:bg-blue-600 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </div>
                        <span class="group-hover:text-white transition-colors">orcacodefree@gmail.com</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    /* Animaciones personalizadas */
    @keyframes fade-in {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slide-up {
        from {
            opacity: 0;
            transform: translateY(40px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes bubble-1 {
        0% {
            transform: translateY(0) scale(1);
            opacity: 0.3;
        }
        50% {
            opacity: 0.5;
        }
        100% {
            transform: translateY(-100px) scale(1.2);
            opacity: 0;
        }
    }

    @keyframes bubble-2 {
        0% {
            transform: translateY(0) scale(1);
            opacity: 0.4;
        }
        50% {
            opacity: 0.6;
        }
        100% {
            transform: translateY(-150px) scale(1.3);
            opacity: 0;
        }
    }

    @keyframes bubble-3 {
        0% {
            transform: translateY(0) scale(1);
            opacity: 0.35;
        }
        50% {
            opacity: 0.55;
        }
        100% {
            transform: translateY(-120px) scale(1.1);
            opacity: 0;
        }
    }

    @keyframes bubble-4 {
        0% {
            transform: translateY(0) scale(1);
            opacity: 0.5;
        }
        50% {
            opacity: 0.7;
        }
        100% {
            transform: translateY(-80px) scale(1.4);
            opacity: 0;
        }
    }

    .animate-fade-in {
        animation: fade-in 1s ease-out forwards;
    }

    .animate-slide-up {
        animation: slide-up 1s ease-out 0.3s forwards;
        opacity: 0;
    }

    .animate-fade-in-delay {
        animation: fade-in 1s ease-out 0.6s forwards;
        opacity: 0;
    }

    .animate-slide-up-delay {
        animation: slide-up 1s ease-out 0.9s forwards;
        opacity: 0;
    }

    .animate-bubble-1 {
        animation: bubble-1 4s ease-in-out infinite;
    }

    .animate-bubble-2 {
        animation: bubble-2 5s ease-in-out infinite 1s;
    }

    .animate-bubble-3 {
        animation: bubble-3 6s ease-in-out infinite 2s;
    }

    .animate-bubble-4 {
        animation: bubble-4 3.5s ease-in-out infinite 0.5s;
    }
</style>