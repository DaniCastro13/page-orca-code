---

const imagesServices = [
    {
        title: '🌐 Aplicaciones Web',
        image: '/images/bg-aplicaciones-web.jpg',
        description: 'Desarrollamos aplicaciones web rápidas, seguras y responsive. Accesibles desde cualquier dispositivo con navegador, ideales para gestionar procesos, plataformas internas o herramientas de productividad con siempre la última versión disponible.'
    },
    {
        title: '📱 Landing Pages',
        image: '../images/bg-landing-page.jpg',
        description: 'Diseño landing pages de alto impacto conversivo. Captamos leads y promocionan tus productos o servicios con diseños atractivos, optimizados para SEO y orientados a resultados medibles.'
    },
    {
        title: '💻 Aplicaciones de Escritorio',
        image: '/images/bg-applicaciones-escritorio.png',
        description: 'Creamos software robusto para Windows, macOS o Linux. Aplicaciones nativas de alto rendimiento, ideales para trabajar sin conexión, con acceso profundo al sistema y máxima seguridad.'
    },
    {
        title: '🛒 Ecommerce',
        image: '/images/bg-ecommerce.png',
        description: 'Tiendas online completas y escalables. Desde el catálogo y carrito hasta pasarelas de pago y logística. Optimizadas para conversión, móviles y con integración multi-canal.'
    },
    {
        title: '🏪 Puntos de Venta (PDV/POS)',
        image: '/images/bg-punto-venta.png', // Corregida la ruta
        description: 'Sistemas de venta física intuitivos y eficientes. Gestiona caja, inventario, clientes y reportes en tiempo real. Ideales para retail, restaurantes o cualquier comercio presencial.'
    },
    {
        title: '⚙️ Sistemas Personalizados',
        image: '/images/bg-sistemas-personalizados.png', // Corregida la ruta
        description: 'Soluciones software a medida para desafíos únicos. Automatizamos procesos específicos de tu negocio, integrando todas las áreas en un sistema unificado y eficiente.'
    }
];
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-10 w-full">
    {imagesServices.map((image) => (
            <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden group relative">
                <div class="absolute inset-0 opacity-5">
                    <div class="absolute -top-10 -right-10 w-40 h-40 bg-blue-500 rounded-full mix-blend-multiply filter blur-xl"></div>
                    <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-blue-700 rounded-full mix-blend-multiply filter blur-xl"></div>
                    <div class="absolute top-20 right-20 w-32 h-32 bg-blue-900 rounded-full mix-blend-multiply filter blur-xl"></div>
                </div>
                <div class="relative bg-gradient-to-r from-blue-800 to-blue-600 p-6 text-white overflow-hidden">
                    <div class="absolute bottom-0 left-0 right-0">
                        <svg viewBox="0 0 100 20" class="w-full h-4 text-white">
                            <path d="M0,10 C20,0 40,20 60,10 C80,0 100,20 100,10 L100,20 L0,20 Z" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-center relative z-10">{image.title}</h3>
                </div>
                <div class="p-4 relative">
                    <div class="relative overflow-hidden rounded-xl border-2 border-blue-100">
                        <img
                                src={image.image}
                                alt={image.title}
                                class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
                        />
                        <div class="absolute top-2 right-2 w-8 h-8 bg-blue-500 rounded-full opacity-20"></div>
                        <div class="absolute bottom-2 left-2 w-6 h-6 bg-blue-700 rounded-full opacity-30"></div>
                    </div>
                </div>
                <div class="p-6 relative z-10">
                    <p class="text-gray-700 leading-relaxed text-justify">{image.description}</p>
                </div>
                <div class="px-6 pb-6 relative">
                    <a
                            href=`https://wa.me/525536325801?text=Hola,%20me%20interesa%20el%20servicio%20de%20${image.title}`
                            target="_blank"
                            class="w-full bg-green-500 hover:bg-green-600 text-white font-semibold py-3 px-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-3 shadow-md hover:shadow-lg hover:scale-105"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                        Consultar servicio
                    </a>
                </div>
            </div>
    ))}
</div>