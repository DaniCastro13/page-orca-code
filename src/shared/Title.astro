---
interface Props {
    title: string;
}
const { title } = Astro.props;
---
<div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-blue-950 uppercase tracking-wide">
        {title}
    </h2>
    <div class="w-24 h-2 bg-gradient-to-r from-blue-300 to-blue-500 mx-auto mt-4 rounded-full"></div>
</div>
