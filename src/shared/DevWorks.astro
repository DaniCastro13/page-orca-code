---
const devUtilities = [
    {
        image: '/images/logo-angular.png',
        name: 'Angular'
    },
    {
        image: '/images/logo-css3.png',
        name: 'CSS3'
    },
    {
        image: '/images/logo-html.png',
        name: 'HTML5'
    },
    {
        image: '/images/logo-java.png',
        name: 'Java'
    },
    {
        image: '/images/logo-js.png',
        name: 'JavaScript'
    },
    {
        image: '/images/logo-mysql.png',
        name: 'MySQL'
    },
    {
        image: '/images/logo-np.png',
        name: 'Node.js'
    },
    {
        image: '/images/logo-react.png',
        name: 'React'
    },
    {
        image: '/images/logo-spring-boot.png',
        name: 'Spring Boot'
    },
    {
        image: '/images/logo-tailwindcss.png',
        name: 'Tailwind CSS'
    }
]
---

<div class="relative w-full overflow-hidden py-16 bg-gradient-to-b from-gray-50 to-white">
    <!-- Título y descripción -->
    <div class="text-center mb-12 px-6">
        <h2 class="text-3xl font-bold text-gray-800 mb-4">Tecnologías & Herramientas</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Domino un stack tecnológico moderno y diverso para crear soluciones robustas y escalables
        </p>
    </div>

    <!-- Carrusel infinito -->
    <div class="relative w-full overflow-hidden">
        <!-- Gradientes en los bordes -->
        <div class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-gray-50 to-transparent z-10"></div>
        <div class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-gray-50 to-transparent z-10"></div>

        <div class="flex animate-infinite-scroll space-x-16">
            <!-- Primera pasada -->
            {devUtilities.map((tool) => (
                    <div class="flex-shrink-0 flex flex-col items-center justify-center group">
                        <div class="w-32 h-32 flex items-center justify-center bg-white rounded-2xl shadow-lg p-6 transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl border border-gray-100 hover:border-blue-200">
                            <img
                                    src={tool.image}
                                    alt={tool.name}
                                    class="w-full h-full object-contain filter grayscale group-hover:grayscale-0 transition-all duration-300 group-hover:brightness-110"
                            />
                        </div>
                        <span class="mt-4 text-lg font-semibold text-gray-700 opacity-80 group-hover:opacity-100 transition-all duration-300">
                        {tool.name}
                    </span>
                    </div>
            ))}

            <!-- Segunda pasada (duplicada para efecto infinito) -->
            {devUtilities.map((tool) => (
                    <div class="flex-shrink-0 flex flex-col items-center justify-center group">
                        <div class="w-32 h-32 flex items-center justify-center bg-white rounded-2xl shadow-lg p-6 transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl border border-gray-100 hover:border-blue-200">
                            <img
                                    src={tool.image}
                                    alt={tool.name}
                                    class="w-full h-full object-contain filter grayscale group-hover:grayscale-0 transition-all duration-300 group-hover:brightness-110"
                            />
                        </div>
                        <span class="mt-4 text-lg font-semibold text-gray-700 opacity-80 group-hover:opacity-100 transition-all duration-300">
                        {tool.name}
                    </span>
                    </div>
            ))}
        </div>
    </div>

    <!-- Texto descriptivo adicional -->
    <div class="text-center mt-12 px-6">
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            Utilizo las mejores herramientas del mercado para garantizar código limpio,
            alto rendimiento y experiencias de usuario excepcionales en cada proyecto.
        </p>
    </div>
</div>

<style>
    @keyframes infinite-scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(calc(-100% / 2));
        }
    }

    .animate-infinite-scroll {
        animation: infinite-scroll 45s linear infinite;
    }

    .animate-infinite-scroll:hover {
        animation-play-state: paused;
    }

    @media (max-width: 768px) {
        .animate-infinite-scroll {
            animation-duration: 35s;
        }
    }
</style>